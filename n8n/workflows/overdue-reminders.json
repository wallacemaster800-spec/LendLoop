{
  "name": "LendLoop — daily overdue reminders",
  "nodes": [
    {
      "id": "every-morning-utc",
      "name": "Every morning UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "run-manually",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        180
      ],
      "parameters": {}
    },
    {
      "id": "prepare-overdue-query",
      "name": "Prepare overdue query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "return [{json:{path:\"/automation/overdue\",data:{}}}];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "sign-overdue-query",
      "name": "Sign overdue query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require(\"crypto\");\nconst secret = $env.N8N_TO_CONVEX_SECRET;\nconst base = $env.CONVEX_SITE_URL;\nif (!secret || secret.length < 32 || !base || !/^https:\\/\\/[^/]+\\.convex\\.site$/.test(base)) {\n  throw new Error(\"Configure the Convex site URL and signing secret\");\n}\nreturn $input.all().map((item) => {\n  const { path, data } = item.json;\n  if (![\"/automation/overdue\", \"/automation/notify\", \"/automation/remind\"].includes(path))\n    throw new Error(\"Unknown integration route\");\n  const body = JSON.stringify(data);\n  const timestamp = Math.floor(Date.now() / 1000).toString();\n  const input = [\"POST\", path, timestamp, body].join(\"\\n\");\n  const signature = crypto.createHmac(\"sha256\", secret).update(input).digest(\"hex\");\n  return { json: { url: base + path, body, timestamp, signature } };\n});\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "fetch-overdue-loans",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "one-item-per-loan",
      "name": "One item per loan",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        880,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "loans",
        "options": {}
      }
    },
    {
      "id": "prepare-reminders",
      "name": "Prepare reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map(item=>({json:{path:\"/automation/remind\",data:{loanId:item.json.loanId,day:item.json.day}}}));",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "sign-reminder-receipts",
      "name": "Sign reminder receipts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require(\"crypto\");\nconst secret = $env.N8N_TO_CONVEX_SECRET;\nconst base = $env.CONVEX_SITE_URL;\nif (!secret || secret.length < 32 || !base || !/^https:\\/\\/[^/]+\\.convex\\.site$/.test(base)) {\n  throw new Error(\"Configure the Convex site URL and signing secret\");\n}\nreturn $input.all().map((item) => {\n  const { path, data } = item.json;\n  if (![\"/automation/overdue\", \"/automation/notify\", \"/automation/remind\"].includes(path))\n    throw new Error(\"Unknown integration route\");\n  const body = JSON.stringify(data);\n  const timestamp = Math.floor(Date.now() / 1000).toString();\n  const input = [\"POST\", path, timestamp, body].join(\"\\n\");\n  const signature = crypto.createHmac(\"sha256\", secret).update(input).digest(\"hex\");\n  return { json: { url: base + path, body, timestamp, signature } };\n});\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "record-mock-reminders",
      "name": "Record mock reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Every morning UTC": {
      "main": [
        [
          {
            "node": "Prepare overdue query",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run manually": {
      "main": [
        [
          {
            "node": "Prepare overdue query",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare overdue query": {
      "main": [
        [
          {
            "node": "Sign overdue query",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign overdue query": {
      "main": [
        [
          {
            "node": "Fetch overdue loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch overdue loans": {
      "main": [
        [
          {
            "node": "One item per loan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per loan": {
      "main": [
        [
          {
            "node": "Prepare reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare reminders": {
      "main": [
        [
          {
            "node": "Sign reminder receipts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign reminder receipts": {
      "main": [
        [
          {
            "node": "Record mock reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "timezone": "Etc/UTC",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "executionTimeout": 300
  },
  "tags": []
}
