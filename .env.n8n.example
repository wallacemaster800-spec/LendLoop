# Copy to .env.n8n. This file is ignored by Git.
# Generate different values for all three secrets; never use these comments as keys.
N8N_ENCRYPTION_KEY=
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=
CONVEX_SITE_URL=
# Public HTTPS endpoint or tunnel, including final slash. Expose only /webhook/ publicly.
N8N_PUBLIC_URL=
