    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "convex": "1.49.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "convex-test": "^0.0.54",
