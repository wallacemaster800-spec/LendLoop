# Next.js (.env.local). Clerk development application keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CONVEX_URL=
# Set by npx convex dev; do not invent a deployment name.
CONVEX_DEPLOYMENT=

# These belong in the Convex dashboard, not NEXT_PUBLIC variables:
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# ADMIN_SUBJECTS=user_your_clerk_id
# N8N_WEBHOOK_URL=https://your-n8n-host/webhook/lendloop-events
# CONVEX_TO_N8N_SECRET=<random 32+ bytes>
# N8N_TO_CONVEX_SECRET=<different random 32+ bytes>

# Next.js and Convex: private key for processed photo uploads.
PHOTO_PROCESSOR_SECRET=
NEXT_PUBLIC_CONVEX_SITE_URL=
